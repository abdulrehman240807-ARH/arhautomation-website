---
import { BRAND } from '../consts'

const year = new Date().getFullYear()

const socials = [
  { label: 'Contra', href: BRAND.links.contra },
  { label: 'Upwork', href: BRAND.links.upwork },
  { label: 'LinkedIn', href: BRAND.links.linkedin },
  { label: BRAND.email, href: `mailto:${BRAND.email}` }
]
---

<footer class="border-t border-[var(--border)] bg-[var(--bg-elevated)]">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-lg font-bold">
          ARH Automation<span class="text-volt">.</span>
        </p>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
          AI automation agency. We engineer n8n systems, AI agents and CRM/API
          integrations with the failure handling most builders skip.
        </p>
        <p class="mt-5 inline-flex items-center gap-2.5 rounded-full border border-[var(--border)] bg-[var(--panel)] px-3.5 py-1.5 font-mono text-xs text-[var(--text-muted)]">
          <span class="status-dot relative inline-block size-2 rounded-full bg-volt" aria-hidden="true"></span>
          systems running — our own automations keep this agency online
        </p>
      </div>

      <nav class="flex flex-col gap-3" aria-label="Social">
        <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--text-muted)]">Elsewhere</span>
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="w-fit font-mono text-sm text-[var(--text-muted)] transition-colors hover:text-volt"
          >
            {s.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-[var(--border)] pt-6 font-mono text-xs text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between">
      <span>© {year} ARH Automation — Abdul Rehman Haris. This site runs on our own automation stack.</span>
      <span>Built with Astro · Tailwind v4 · shipped from the control room</span>
    </div>
  </div>
</footer>
