---
interface Props {
  kicker: string
  title: string
  description?: string
  align?: 'left' | 'center'
}

const { kicker, title, description, align = 'left' } = Astro.props
---

<div class:list={['reveal', align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl']}>
  <p class="flex items-center gap-2 font-mono text-[12px] uppercase tracking-[0.24em] text-volt {align === 'center' ? 'justify-center' : ''}">
    <span class="inline-block h-px w-6 bg-volt/60" aria-hidden="true"></span>
    {kicker}
  </p>
  <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-relaxed text-[var(--text-muted)]">{description}</p>}
</div>
