---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import SectionHead from '../../components/SectionHead.astro'
import { BRAND } from '../../consts'

const cases = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
)
---

<Base
  title="Case Files — ARH Automation | n8n, AI Agents & CRM Systems in Production"
  description="Five production automations: a global doctor-data engine, GoHighLevel CRM ops with an AI reporting agent, WhatsApp order workflows, a structured-intake chatbot and our own Architect OS."
>
  <section class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="violet-glow -top-40 right-[-160px] opacity-60" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-5 pb-24 pt-24 sm:px-8 sm:pt-32">
      <SectionHead
        kicker="Case Files"
        title="Systems in production, not slideware."
        description="Every file below is a system that runs unattended — with validation, retries and error handling baked in. Client names withheld; outcomes are real."
      />

      <div class="mt-14 flex flex-col gap-5">
        {cases.map((entry, i) => (
          <a href={`/work/${entry.slug}`} class="block">
            <article
              class="hairline reveal group grid gap-6 rounded-xl p-6 transition-colors hover:border-volt/40 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:p-8"
              style={`transition-delay:${i * 80}ms`}
            >
              <span class="font-display text-3xl font-bold text-[var(--text-muted)] transition-colors group-hover:text-volt sm:text-4xl">
                {String(entry.data.order).padStart(2, '0')}
              </span>
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-violet">{entry.data.kicker}</p>
                <h2 class="mt-2 font-display text-lg font-bold leading-snug transition-colors group-hover:text-volt sm:text-xl">
                  {entry.data.title}
                </h2>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--text-muted)]">{entry.data.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {entry.data.stack.map((tech) => (
                    <span class="rounded-full border border-[var(--border)] bg-[var(--panel)] px-2.5 py-1 font-mono text-[11px] text-[var(--text-muted)]">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
              <span class="hidden font-mono text-sm text-volt opacity-0 transition-opacity group-hover:opacity-100 sm:inline">
                Read case file →
              </span>
            </article>
          </a>
        ))}
      </div>

      <div class="reveal mt-16 flex flex-col items-center gap-4 rounded-xl border border-[var(--border)] bg-[var(--panel)] p-8 text-center sm:flex-row sm:justify-between sm:text-left">
        <p class="max-w-md text-sm leading-relaxed text-[var(--text-muted)]">
          Want the full walkthrough of any of these systems — including the error
          handling? Book a free audit call and we'll map it live.
        </p>
        <a
          href={BRAND.booking}
          target="_blank"
          rel="noopener noreferrer"
          class="volt-glow shrink-0 rounded-full bg-volt px-6 py-3 font-mono text-sm font-semibold text-[#06090c] transition-transform hover:scale-[1.03] active:scale-95"
        >
          Book a free audit call →
        </a>
      </div>
    </div>
  </section>
</Base>
