---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { BRAND } from '../../consts'

export async function getStaticPaths() {
  const cases = await getCollection('work')
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }))
}

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'work'>>>[number]
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Base title={`${entry.data.title} — Case File — ARH Automation`} description={entry.data.description}>
  <section class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-3xl px-5 pb-24 pt-24 sm:px-8 sm:pt-28">
      <!-- back link -->
      <a
        href="/work"
        class="reveal inline-flex items-center gap-2 font-mono text-sm text-[var(--text-muted)] transition-colors hover:text-volt"
      >
        ← All case files
      </a>

      <!-- kicker + title -->
      <header class="reveal mt-8">
        <p class="flex items-center gap-2 font-mono text-[12px] uppercase tracking-[0.24em] text-volt">
          <span class="inline-block h-px w-6 bg-volt/60" aria-hidden="true"></span>
          Case {String(entry.data.order).padStart(2, '0')} · {entry.data.kicker}
        </p>
        <h1 class="mt-4 font-display text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
          {entry.data.title}
        </h1>
      </header>

      <!-- story -->
      <div class="reveal mt-8 space-y-5 text-base leading-relaxed text-[var(--text-muted)]">
        <p>{entry.data.story}</p>
        <Content />
      </div>

      <!-- quote (if present) -->
      {entry.data.quote && (
        <figure class="reveal mt-10 rounded-xl border-l-2 border-volt/60 bg-[var(--panel)] p-6">
          <blockquote class="font-display text-lg leading-snug text-[var(--text)]">
            “{entry.data.quote.text}”
          </blockquote>
          <figcaption class="mt-3 font-mono text-xs uppercase tracking-[0.18em] text-[var(--text-muted)]">
            — {entry.data.quote.author}
          </figcaption>
        </figure>
      )}

      <!-- what we built -->
      <section class="reveal mt-12">
        <h2 class="font-mono text-[12px] uppercase tracking-[0.24em] text-violet">What we built</h2>
        <ul class="mt-5 space-y-3">
          {entry.data.built.map((b) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-[var(--text)]">
              <svg class="mt-1 shrink-0 text-volt" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {b}
            </li>
          ))}
        </ul>
      </section>

      <!-- metrics row -->
      <section class="reveal mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)] sm:grid-cols-3">
        {entry.data.metrics.map((m) => (
          <div class="bg-[var(--panel)] p-6 text-center">
            <p class="font-display text-xl font-bold text-volt sm:text-2xl">{m.value}</p>
            <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--text-muted)]">{m.label}</p>
          </div>
        ))}
      </section>

      <!-- stack chips -->
      <section class="reveal mt-10">
        <h2 class="font-mono text-[12px] uppercase tracking-[0.24em] text-violet">Stack</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {entry.data.stack.map((tech) => (
            <span class="rounded-full border border-[var(--border-strong)] bg-[var(--bg-elevated)] px-3.5 py-1.5 font-mono text-xs text-[var(--text)]">
              {tech}
            </span>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="reveal mt-14 rounded-xl border border-[var(--border)] bg-[var(--panel)] p-8 text-center">
        <p class="font-mono text-[12px] uppercase tracking-[0.24em] text-volt">Want this for your business?</p>
        <h2 class="mt-3 font-display text-2xl font-bold tracking-tight">Book a free audit call.</h2>
        <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={BRAND.booking}
            target="_blank"
            rel="noopener noreferrer"
            class="volt-glow w-full rounded-full bg-volt px-7 py-3.5 font-mono text-sm font-semibold text-[#06090c] transition-transform hover:scale-[1.03] active:scale-95 sm:w-auto"
          >
            Schedule on Calendly →
          </a>
          <a
            href={`mailto:${BRAND.email}`}
            class="font-mono text-sm text-[var(--text-muted)] underline decoration-[var(--border-strong)] underline-offset-4 transition-colors hover:text-volt"
          >
            {BRAND.email}
          </a>
        </div>
      </section>

      <!-- back link bottom -->
      <div class="mt-12 text-center">
        <a href="/work" class="font-mono text-sm text-[var(--text-muted)] transition-colors hover:text-volt">
          ← Back to all case files
        </a>
      </div>
    </div>
  </section>
</Base>
