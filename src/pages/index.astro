---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import SectionHead from '../components/SectionHead.astro'
import ServiceCard from '../components/ServiceCard.astro'
import Marquee from '../components/Marquee.astro'
import { BRAND } from '../consts'

const services = [
  {
    index: '01',
    title: 'Lead-Gen & Follow-Up Machines',
    description:
      'Capture, dedupe, enrich, qualify, route and follow up — a revenue pipeline that runs whether or not anyone is at the desk.',
    bullets: [
      'Form / DM / webhook capture with input validation',
      'Dedupe before anything is written — no double records',
      'Enrichment + qualification scoring on every lead',
      'Automatic routing and multi-step follow-up sequences'
    ],
    tag: 'Revenue'
  },
  {
    index: '02',
    title: 'AI Agents & Chatbots',
    description:
      'Claude and OpenAI agents built on structured outputs and tool calling — with a clean human handoff when it matters.',
    bullets: [
      'Schema-constrained structured outputs, not free text',
      'Tool calling into your CRM, calendar and data stores',
      'Guardrails, validation and confidence thresholds',
      'Human handoff wired in from day one'
    ],
    tag: 'Intelligence'
  },
  {
    index: '03',
    title: 'CRM & Back-Office Automation',
    description:
      'HighLevel, HubSpot and Sheets operated end-to-end — pipeline moves, tagging, bookings and reports handled by the system.',
    bullets: [
      'Pipeline stage moves and tagging rules that stay accurate',
      'Booking flows and reminders across sub-accounts',
      'End-of-day reports generated and delivered automatically',
      'Data hygiene: merges, cleanses and audit trails'
    ],
    tag: 'Operations'
  },
  {
    index: '04',
    title: 'API & Messaging Integration',
    description:
      'REST, webhooks, WhatsApp Business API and Telegram — including the platforms whose documentation reads like an afterthought.',
    bullets: [
      'Custom REST + webhook integrations with retry logic',
      'WhatsApp Business API messaging flows',
      'Telegram bots for alerts, digests and internal ops',
      'Undocumented APIs reverse-engineered and wrapped properly'
    ],
    tag: 'Integration'
  }
]

const stats = [
  { value: '6+', label: 'Production systems live' },
  { value: '2', label: 'Long-term engagements (HK · US)' },
  { value: '5.0★', label: 'Upwork rating' },
  { value: '0', label: 'Silent failures shipped' }
]

const stack = [
  'n8n', 'Make.com', 'Claude', 'OpenAI', 'HighLevel', 'HubSpot',
  'WhatsApp Business API', 'Telegram', 'Google Sheets', 'REST APIs',
  'Webhooks', 'Airtable', 'Zapier', 'Supabase'
]

const howWeBuild = [
  'Input validation before anything is written',
  'Duplicate & repeat-execution prevention',
  'Human approval on anything that costs money or contacts a customer',
  'Timeouts, retries and fallbacks on every external call',
  'Dedicated error workflow — no silent failures',
  'Auditable execution logs for every run',
  'Edge-case testing before handover',
  'Docs + Loom walkthrough at handover'
]

// Teaser shows cases 01, 02 and 04
const allCases = await getCollection('work')
const teasers = ['doctor-data-engine', 'crm-autopilot-parent-reports', 'structured-intake-chatbot']
  .map((slug) => allCases.find((c) => c.slug === slug)!)
  .filter(Boolean)
---

<Base>
  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="violet-glow -top-40 left-1/2 -translate-x-1/2 opacity-70" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-5 pb-20 pt-24 sm:px-8 sm:pt-32">
      <div class="reveal mx-auto max-w-3xl text-center">
        <p class="mx-auto inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--panel)] px-4 py-1.5 font-mono text-xs uppercase tracking-[0.2em] text-[var(--text-muted)]">
          <span class="status-dot relative inline-block size-1.5 rounded-full bg-volt" aria-hidden="true"></span>
          ARH Automation — AI automation architect
        </p>

        <h1 class="mt-7 font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl">
          We architect AI automation systems<br />
          that keep running <span class="text-volt">after the demo.</span>
        </h1>

        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-[var(--text-muted)] sm:text-lg">
          n8n systems, AI agents, CRM &amp; API integration — engineered with
          validation, retries and error handling that catch failures at 2am.
          Not demo-day toys.
        </p>

        <p class="mx-auto mt-6 max-w-2xl border-l-2 border-volt/50 pl-4 text-left text-sm italic leading-relaxed text-[var(--text-muted)]">
          Most automation looks fine in a clean test run. The problems start later —
          an API times out at 2am, the same lead gets created twice, volume triples
          and records go missing. We build for that day, not for demo day.
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={BRAND.booking}
            target="_blank"
            rel="noopener noreferrer"
            class="volt-glow w-full rounded-full bg-volt px-7 py-3.5 text-center font-mono text-sm font-semibold text-[#06090c] transition-transform hover:scale-[1.03] active:scale-95 sm:w-auto"
          >
            Book a free audit call →
          </a>
          <a
            href="/work"
            class="w-full rounded-full border border-[var(--border-strong)] px-7 py-3.5 text-center font-mono text-sm text-[var(--text)] transition-colors hover:border-volt hover:text-volt sm:w-auto"
          >
            See the systems
          </a>
        </div>
      </div>

      <!-- ===== Live workflow canvas ===== -->
      <div class="reveal relative mx-auto mt-16 max-w-4xl" style="transition-delay:150ms">
        <div class="hairline rounded-2xl p-4 shadow-[0_0_80px_-20px_rgba(124,92,255,0.35)] sm:p-5">
          <!-- window chrome -->
          <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
            <div class="flex items-center gap-2">
              <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
              <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
              <span class="size-2.5 rounded-full bg-volt"></span>
              <span class="ml-3 font-mono text-xs text-[var(--text-muted)]">workflow://lead-machine.main</span>
            </div>
            <span class="inline-flex items-center gap-2 rounded-full border border-volt/30 bg-[var(--volt-dim)] px-3 py-1 font-mono text-[11px] text-volt">
              <span class="status-dot relative inline-block size-1.5 rounded-full bg-volt" aria-hidden="true"></span>
              LIVE
            </span>
          </div>

          <!-- canvas -->
          <div class="relative h-56 overflow-hidden rounded-xl bg-[radial-gradient(circle_at_50%_50%,rgba(148,163,184,0.08),transparent_70%)] sm:h-64">
            <svg class="absolute inset-0 h-full w-full" preserveAspectRatio="none" viewBox="0 0 800 260" aria-hidden="true">
              <path class="wire" d="M185 130 C 235 130, 235 70, 285 70" />
              <path class="wire" d="M435 70 C 485 70, 485 130, 535 130" style="animation-delay:-0.4s" />
              <path class="wire" d="M665 130 C 700 130, 700 195, 665 195 L 285 195 C 240 195, 240 160, 185 160" style="animation-delay:-0.8s" />
              <circle r="3.5" fill="#9DFF3C">
                <animateMotion dur="2.2s" repeatCount="indefinite" path="M185 130 C 235 130, 235 70, 285 70" />
              </circle>
              <circle r="3.5" fill="#7c5cff">
                <animateMotion dur="2.2s" begin="0.7s" repeatCount="indefinite" path="M435 70 C 485 70, 485 130, 535 130" />
              </circle>
            </svg>

            <!-- nodes -->
            <div class="canvas-node absolute left-[3%] top-1/2 w-36 -translate-y-1/2 rounded-lg border border-volt/40 bg-[var(--panel)] p-3">
              <p class="font-mono text-[10px] uppercase tracking-widest text-volt">trigger</p>
              <p class="mt-1.5 font-display text-sm font-semibold">New Lead In</p>
              <p class="mt-1 font-mono text-[10px] text-[var(--text-muted)]">webhook · form</p>
            </div>

            <div class="canvas-node absolute left-[36%] top-[12%] w-36 rounded-lg border border-violet/40 bg-[var(--panel)] p-3" style="animation-delay:0.6s">
              <p class="font-mono text-[10px] uppercase tracking-widest text-violet">ai step</p>
              <p class="mt-1.5 font-display text-sm font-semibold">AI Enrich</p>
              <p class="mt-1 font-mono text-[10px] text-[var(--text-muted)]">claude · validate</p>
            </div>

            <div class="canvas-node absolute right-[14%] top-1/2 w-36 -translate-y-1/2 rounded-lg border border-volt/40 bg-[var(--panel)] p-3" style="animation-delay:1.2s">
              <p class="font-mono text-[10px] uppercase tracking-widest text-volt">sync</p>
              <p class="mt-1.5 font-display text-sm font-semibold">CRM Upsert</p>
              <p class="mt-1 font-mono text-[10px] text-[var(--text-muted)]">dedupe · highlevel</p>
            </div>

            <div class="canvas-node absolute bottom-[8%] left-[24%] w-36 rounded-lg border border-[var(--border-strong)] bg-[var(--panel)] p-3" style="animation-delay:1.8s">
              <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--text-muted)]">action</p>
              <p class="mt-1.5 font-display text-sm font-semibold">Follow-up</p>
              <p class="mt-1 font-mono text-[10px] text-[var(--text-muted)]">sequence · whatsapp</p>
            </div>
          </div>

          <!-- console strip -->
          <div class="mt-3 flex items-center gap-3 overflow-hidden rounded-lg border border-[var(--border)] bg-[#04070a] px-3 py-2 font-mono text-[11px] text-[var(--text-muted)]">
            <span class="shrink-0 text-volt">✓</span>
            <span class="truncate">exec #4821 · validated · deduped · enriched · logged · follow-up scheduled · 0 errors</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE ================= -->
  <Marquee items={stack} />

  <!-- ================= STATS ================= -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="reveal grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)] lg:grid-cols-4">
      {stats.map((s) => (
        <div class="bg-[var(--panel)] p-6 text-center sm:p-8">
          <p class="font-display text-3xl font-bold text-volt sm:text-4xl">{s.value}</p>
          <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--text-muted)]">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section id="services" class="mx-auto max-w-6xl scroll-mt-24 px-5 pb-24 sm:px-8">
    <SectionHead
      kicker="Services"
      title="Four systems we build and operate"
      description="Pick one or wire them together. Every build ships with validation, error handling, monitoring and handover docs."
    />
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {services.map((s) => (
        <ServiceCard {...s} />
      ))}
    </div>
  </section>

  <!-- ================= HOW WE BUILD ================= -->
  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
    <SectionHead
      kicker="How we build"
      title="The engineering most automation shops skip."
      description="These aren't extras. They're the difference between a workflow that demos well and one that survives production."
    />
    <div class="reveal mt-12 grid gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)] sm:grid-cols-2">
      {howWeBuild.map((rule, i) => (
        <div class="flex items-start gap-4 bg-[var(--panel)] p-5 sm:p-6">
          <span class="mt-0.5 font-mono text-xs tracking-[0.2em] text-volt">{String(i + 1).padStart(2, '0')}</span>
          <p class="text-sm leading-relaxed text-[var(--text)]">{rule}</p>
        </div>
      ))}
    </div>

    <!-- Architect OS strip -->
    <div class="reveal mt-6 flex flex-col gap-4 rounded-xl border border-violet/30 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8" style="background:linear-gradient(90deg, rgba(124,92,255,0.08), rgba(157,255,60,0.05));">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-violet">Architect OS</p>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--text)] sm:text-base">
          We run our practice on our own systems — lead capture, enrichment, CRM,
          automated follow-ups, daily digest. Every lead touched in under 60 seconds.
        </p>
      </div>
      <a
        href="/work/agency-os"
        class="shrink-0 font-mono text-sm text-volt underline decoration-volt/40 underline-offset-4 transition-colors hover:decoration-volt"
      >
        Read the case file →
      </a>
    </div>
  </section>

  <!-- ================= CASE STUDIES TEASER ================= -->
  <section class="border-y border-[var(--border)] bg-[var(--bg-elevated)] py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <SectionHead
        kicker="Case Files"
        title="Systems in production, not slideware."
        description="A sample from the fleet — delivered for clients in Hong Kong and the US, plus our own internal stack."
      />
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {teasers.map((entry, i) => (
          <a href={`/work/${entry.slug}`} class="block">
            <article class="hairline reveal group h-full rounded-xl p-6 transition-colors hover:border-violet/40 sm:p-7" style={`transition-delay:${i * 100}ms`}>
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--text-muted)]">{entry.data.kicker}</span>
              <h3 class="mt-5 font-display text-lg font-bold leading-snug transition-colors group-hover:text-volt">{entry.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{entry.data.description}</p>
              <p class="mt-6 inline-flex items-center gap-2 font-mono text-xs text-volt opacity-0 transition-opacity group-hover:opacity-100">
                Read case file →
              </p>
            </article>
          </a>
        ))}
      </div>
      <div class="reveal mt-10 text-center">
        <a
          href="/work"
          class="inline-flex items-center gap-2 rounded-full border border-[var(--border-strong)] px-6 py-3 font-mono text-sm text-[var(--text)] transition-colors hover:border-volt hover:text-volt"
        >
          All 5 case files →
        </a>
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section id="contact" class="relative scroll-mt-24 overflow-hidden py-28">
    <div class="violet-glow -bottom-40 right-[-120px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-5 text-center sm:px-8">
      <div class="reveal hairline rounded-2xl p-10 shadow-[0_0_100px_-30px_rgba(157,255,60,0.25)] sm:p-14">
        <p class="font-mono text-[12px] uppercase tracking-[0.24em] text-volt">Free 30-min audit</p>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Bring us the process<br class="hidden sm:block" /> that keeps breaking.
        </h2>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-[var(--text-muted)] sm:text-base">
          On the call we map the workflow, find where it fails silently, and give
          you a concrete build plan — whether or not you work with us.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={BRAND.booking}
            target="_blank"
            rel="noopener noreferrer"
            class="volt-glow w-full rounded-full bg-volt px-8 py-3.5 font-mono text-sm font-semibold text-[#06090c] transition-transform hover:scale-[1.03] active:scale-95 sm:w-auto"
          >
            Book a free audit call
          </a>
          <a
            href={`mailto:${BRAND.email}`}
            class="font-mono text-sm text-[var(--text-muted)] underline decoration-[var(--border-strong)] underline-offset-4 transition-colors hover:text-volt"
          >
            {BRAND.email}
          </a>
        </div>
        <p class="mt-6 font-mono text-[11px] text-[var(--text-muted)]">
          Founder: Abdul Rehman Haris · Replies within one business day
        </p>
      </div>
    </div>
  </section>
</Base>
